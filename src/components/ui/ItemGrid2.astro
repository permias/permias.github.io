---
import type { ItemGrid as Props } from '~/types';
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';
import Button from './Button.astro';

const { items = [], columns, defaultIcon = '', classes = {} } = Astro.props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = 'text-primary',
} = classes;
---

{
  items && (
    <div
      class={twMerge(
        `grid gap-8 gap-x-12 sm:gap-y-8 ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
              ? 'lg:grid-cols-3 sm:grid-cols-2'
              : columns === 2
                ? 'sm:grid-cols-2 '
                : ''
        }`,
        containerClass
      )}
    >
      {items.map(({ title, description, icon, callToAction, panelBgImage, href, classes: itemClasses = {} }) => {
        const hoverClass = href ? 'hover:scale-105 hover:shadow-2xl hover:border-primary cursor-pointer' : '';
        const cardContent = (
          <div
            class={twMerge(
              `relative flex flex-col intersect-once intersect-quarter intersect-no-queue 
             motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade 
             transition-transform duration-200 ease-out will-change-transform`,
              hoverClass,
              panelClass,
              itemClasses?.panel
            )}
            style={{
              backgroundImage: panelBgImage ? `url('${panelBgImage}')` : undefined,
              backgroundSize: panelBgImage ? 'cover' : undefined,
              backgroundPosition: panelBgImage ? 'center' : undefined,
            }}
          >
            {(icon || defaultIcon) && (
              <Icon name={icon || defaultIcon} class={twMerge('mb-2 w-10 h-10', defaultIconClass, itemClasses?.icon)} />
            )}
            <div class={twMerge('text-xl font-bold', titleClass, itemClasses?.title)}>{title}</div>
            {description && (
              <p
                class={twMerge('text-muted mt-2', descriptionClass, itemClasses?.description)}
                set:html={description}
              />
            )}
            {callToAction && (
              <div class="mt-2">
                <Button {...callToAction} />
              </div>
            )}
          </div>
        );
        return href ? (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="block focus:outline-none focus:ring-2 focus:ring-primary"
          >
            {cardContent}
          </a>
        ) : (
          cardContent
        );
      })}
    </div>
  )
}
