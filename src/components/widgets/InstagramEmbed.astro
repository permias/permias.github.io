---

const { link = [] } = Astro.props;

---

<div class="flex justify-center mb-[100px]">
    <blockquote 
      class="instagram-media mx-auto bg-white border-0 rounded-[3px] 
      shadow-[0_0_1px_0_rgba(0,0,0,0.5),_0_1px_10px_0_rgba(0,0,0,0.15)] m-[1px] lg:w-[750px]  p-0 md:w-[500px] w-[250px]"
      data-instgrm-permalink={link} 
      data-instgrm-version="14">
    </blockquote>
    <script async src="//www.instagram.com/embed.js"></script>
  </div>