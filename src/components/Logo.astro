---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import logoRed from '~/assets/images/permias-horizontal-red.png';
import logoWhite from '~/assets/images/permias-horizontal-white.png';
---

<span
  class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
>
  <Image src={logoRed} alt="" class="dark:hidden h-10 md:h-8 object-contain" />
  <Image src={logoWhite} alt="" class="hidden dark:block h-10 md:h-8 object-contain" />
</span>
