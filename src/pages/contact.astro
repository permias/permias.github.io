---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features4.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

  <ContactUs
    id="form"
    title="Drop us a message today!"
    subtitle="We are available and welcome any type of message!"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        placeholder: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: 'name@example.com',
      },
    ]}
    textarea={{
      label: 'Message',
      placeholder: 'I want to connect!'
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    description="Our team typically responds within 24 business hours."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Follow & Subscribe to Our Socials!"
    items={[
      {
        title: 'Email',
        description: 'info@permiasnasional.com',
        icon: 'tabler:mail',
        href: 'mailto::info@permiasnasional.com',
      },
      {
        title: 'Newsletter',
        description: 'Sign Up for Our Mailing List',
        icon: 'tabler:news',
        href: 'http://eepurl.com/g-RXeT',
      },
      {
        title: 'Instagram',
        description: '@permias.nasional',
        icon: 'tabler:brand-instagram',
        href: 'https://www.instagram.com/permias.nasional/',
      },
    ]}
  />
  <div class="lg:mt-[-150px] mt-[-60px] mb-[100px]">
    <Features2
      items={[
        {
          title: 'Facebook',
          description: '@permias.nasional',
          icon: 'tabler:brand-facebook',
          href: 'https://instagram.com/',
        },
        {
          title: 'LinkedIn',
          description: 'PERMIAS Nasional',
          icon: 'tabler:brand-linkedin',
          href: 'https://www.linkedin.com/company/permiasnasional',
        },
        {
          title: 'YouTube',
          description: 'PERMIAS Nasional',
          icon: 'tabler:brand-youtube',
          href: 'https://www.youtube.com/channel/UCHjEGs027y3g--ZH5BCS7tw',
        },
      ]}
    />
  </div>
</Layout>
