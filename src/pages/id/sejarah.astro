---
import Layout from '~/layouts/PageLayout.astro';
import PermiasTimeline from "~/components/widgets/TimelinePermias.astro";
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import VisiMisi from '~/components/widgets/VisiMisi.astro';
// import Stats from '~/components/widgets/Stats.astro';
import Brands from '~/components/widgets/Brands.astro';

import { YouTube } from 'astro-embed';

const metadata = {
  title: 'Sejarah Kami',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="PERMIAS NASIONAL"
  >
    <Fragment slot="title">
      Sejarah Kami
    </Fragment>

    <Fragment slot="subtitle">
      Cabang PERMIAS pertama didirikan selama Kongres 
      <span class="font-semibold">PERMIAS I di Washington, D.C pada tanggal 24 Desember 1961.</span> 
    </Fragment>

    <Fragment slot="image">
      <YouTube id="YXJGqoOUEjc" title="Why are you proud to be Indonesian? | Ignite Indonesia by PERMIAS Nasional" />
      <style is:inline>
        lite-youtube {
          margin: 0 auto;
          max-width: 100%;
        }
      </style>
    </Fragment>
  </Hero>

  <PermiasTimeline
  id="permias-info"
  title="PERMIAS Information"
  subtitle="Explore the roles and history of PERMIAS in the United States."
  boxes={[
    "Meskipun sudah ada organisasi mahasiswa Indonesia yang ada di kota-kota lain sebelumnya, seperti PERPINDO di New York City atau PERMABA di San Francisco, pendirian PERMIAS lah yang mengkatalisasi penyatuan semua mahasiswa Indonesia di Amerika Serikat di bawah satu nama organisasi.",
    "Seiring berjalannya waktu, peningkatan jumlah orang Indonesia yang berimigrasi ke Amerika Serikat untuk pendidikan yang lebih baik diikuti dengan ekspansi cabang-cabang PERMIAS. Hal ini menghasilkan pendirian PERMIAS Nasional, yang bertindak sebagai penghubung untuk semua cabang PERMIAS di seluruh Amerika Serikat.",
    "Sebuah PERMIAS dapat menjadi organisasi untuk semua mahasiswa Indonesia di sebuah kota/daerah atau asosiasi mahasiswa Indonesia di dalam universitas yang terafiliasi. Klub dalam universitas juga memiliki berbagai nama, seperti Perhimpunan Mahasiswa Indonesia, dll."
  ]}
/>

  <!-- Features2 Widget ************** -->

  <VisiMisi
  id="visi-misi"
  contentVisi={[
    "Sustainably expand opportunities for Indonesian students in the U.S. by cultivating a strong, empowered community rooted in collaboration and mutual support.",
    "We strive to create a resilient network that continually opens new pathways for academic, personal, and professional growth, ensuring that Indonesian students can thrive and succeed in the U.S. and beyond.",
  ]}
  contentMisi={[
    "Uphold an inclusive and welcoming network that enriches the experience of Indonesian students through dedicated programs and targeted initiatives.",
    "We aim to foster a supportive environment that celebrates Indonesian culture, provides resources for personal and professional development, and ensures a well-rounded, holistic experience for students as they navigate their academic journeys in the U.S.",
  ]}
  />


  <!-- Features2 Widget ************** -->

  <Features2
  title="Servis Kami"
  subtitle="PERMIAS Nasional menyediakan acara, kemitraan, dan peluang jaringan karier. Kami juga bekerja sama dengan pemerintah Indonesia yang berada di Amerika Serikat untuk memastikan keselamatan mahasiswa kami."
  items={[
    {
      title: 'Panel',
      description:
        'Ikuti diskusi panel interaktif bersama para ahli industri, alumni, dan perwakilan pemerintah untuk mengeksplorasi peluang dan tantangan bagi mahasiswa Indonesia di Amerika Serikat.',
      icon: 'tabler:info-circle', 
    },
    {
      title: 'Webinar',
      description:
        'Hadiri webinar informatif yang membahas topik seperti adaptasi budaya, pengembangan karier, dan kesuksesan akademik yang dirancang khusus untuk mahasiswa Indonesia di Amerika.',
      icon: 'tabler:video', 
    },
    {
      title: 'Diskusi',
      description:
        'Berpartisipasi dalam diskusi aktif dan sesi tanya jawab untuk membahas berbagai kekhawatiran, berbagi pengalaman, dan mempererat dukungan komunitas antar anggota.',
      icon: 'tabler:messages', 
    },
  ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

 <!-- Stats Widget ******************

  <Stats
    title="Discover the impressive impact of Astrowind"
    subtitle="The numbers below reflect the trust our users have placed in us and the remarkable outcomes we've helped them achieve."
    stats={[
