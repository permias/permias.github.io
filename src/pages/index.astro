---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';

const metadata = {
  title: 'Home',
  ignoreTitleTemplate: false,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Join our mailing list',
        href: 'https://groups.google.com/g/permias-nasional?pli=1',
        target: '_blank',
        icon: 'tabler:mail',
      },
      {
        variant: 'primary',
        text: 'Get in touch with a PERMIAS Chapter near you!',
        href: 'https://www.permiasnasional.com/chapters',
        target: '_blank',
        icon: 'tabler:map-2',
      },
    ]}
    image={{
      src: 'https://images.squarespace-cdn.com/content/v1/5c72899370468014b15d3162/1674786322600-II67DVDNVLZNNSH755EN/SEQUENCE1-4_2023.gif?format=2500w',
      alt: 'Activity Video',
    }}
  >
    <Fragment slot="title">
      Welcome to <span class="text-accent dark:text-white highlight">PERMIAS</span>!
    </Fragment>

    <Fragment slot="subtitle">
      The PERMIAS Community is here to <span class="font-semibold">support</span> you in achieving your professional goals,
      while providing an inclusive community of Indonesian students and alumni across the United States.
    </Fragment>
  </Hero>
</Layout>
