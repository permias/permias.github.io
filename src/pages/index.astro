---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/HeroHome.astro';

const metadata = {
  title: 'Home',
  ignoreTitleTemplate: false,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Welcome to PERMIAS Nasional"
    actions={[
      {
        variant: 'primary',
        text: 'Join our mailing list',
        href: 'https://groups.google.com/g/permias-nasional?pli=1',
        target: '_blank',
        icon: 'tabler:mail',
      },
      {
        variant: 'primary',
        text: 'Get in touch with a PERMIAS Chapter near you!',
        href: '/about/chapters',
        icon: 'tabler:map-2',
      },
    ]}
    image={{
      src: '~/assets/images/home-animation.gif',
      alt: 'Activity Video',
    }}
  >
    <Fragment slot="title">
      Join the community of <span class="text-accent dark:text-white highlight">Indonesian</span> students in the United
      States!
    </Fragment>

    <Fragment slot="subtitle">
      The PERMIAS Community is here to <span class="font-semibold">support</span> you in achieving your professional goals,
      while providing an inclusive community of Indonesian students and alumni across the United States.
    </Fragment>
  </Hero>
</Layout>
