---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/HeroHome.astro';

const metadata = {
  title: 'Home',
  ignoreTitleTemplate: false,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget -->
  <Hero
    tagline="Persatuan Mahasiswa Indonesia di Amerika Serikat"
    actions={[
      {
        variant: 'primary',
        text: 'Gabung dalam milis kami',
        href: 'https://groups.google.com/g/permias-nasional?pli=1',
        target: '_blank',
        icon: 'tabler:mail',
      },
      {
        variant: 'primary',
        text: 'Cari PERMIAS chapter terdekat',
        href: '/about/chapters',
        icon: 'tabler:map-2',
      },
    ]}
    image={{
      src: '~/assets/images/home-animation.gif',
      alt: 'Video aktivitas PERMIAS Nasional',
    }}
  >
    <Fragment slot="title">
      Jadi bagian dari komunitas pelajar <span class="text-accent">Indonesia</span> di Amerika Serikat!
    </Fragment>

    <Fragment slot="subtitle">
      PERMIAS hadir untuk <span class="font-semibold">mendukung</span> kamu dalam mencapai tujuan <span
        class="font-semibold">akademik</span
      > dan <span class="font-semibold">profesional</span>
      melalui komunitas inklusif bagi pelajar dan alumni Indonesia di seluruh Amerika Serikat.
    </Fragment>
  </Hero>
</Layout>
