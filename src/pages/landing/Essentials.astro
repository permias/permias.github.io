      image: { src: "https://media.licdn.com/dms/image/v2/C560BAQFgGSv12585XA/company-logo_200_200/company-logo_200_200/0/1631399532993/agaeti_venture_capital_logo?e=2147483647&v=beta&t=inMMGzw43H2aq2zigGJKw1hunl9tLSVf_2rCZhFIIjc", alt: "Agaeti Ventures" }
    },
    {
