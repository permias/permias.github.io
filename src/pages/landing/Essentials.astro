---
import Layout from '~/layouts/LandingLayout.astro';
import EmbassiesFeature from '~/components/widgets/EmbassiesFeature.astro';
import Hero3 from '~/components/widgets/Hero3-Visa&Jobs.astro';
import Acedemics from '~/components/widgets/Hero4-Academics.astro';
import ResearchSection from '~/components/widgets/ResearchSection.astro';
import Header from '~/components/widgets/Header.astro';
import Scholarships from '~/components/widgets/Scholarships.astro';
import Entrepreneurship from '~/components/widgets/Entrepreneurship.astro'; 

const metadata = {
  title: 'Sales Landing Page Demo',
};
---


<Layout metadata={metadata}>
    <Fragment slot="announcement"></Fragment>
    <Fragment slot="header">
      <Header
        links={[
          { text: 'Embassies', href: '#Embassies' },
          { text: 'Visa', href: '#visa-process' },
          { text: 'Academics', href: '#Academics' },
          { text: 'Jobs', href: '#Job_Hunting' },
          { text: 'Research', href: '#Research' },
          { text: 'Scholarships', href: '#Scholarships' },
          { text: 'Entrepreneurship', href: '#Entrepreneurship' },
        ]}
        actions={[
          {
            text: 'Back',
            href: '/',
          },
        ]}
        isSticky
        showToggleTheme
      />
    </Fragment>

  <!-- Embassies -->
  <EmbassiesFeature
  id="Embassies"
  title="Contact the Indonesian Embassies"
  subtitle="Explore our resources to connect with Indonesian embassies, ensuring support and guidance for your endeavors abroad."
  columns={3}
  items={[
    {
      title: 'Embassy of the Republic of Indonesia in USA',
      address: '2020 Massachusetts Ave NW, Washington, DC 20036',
      website: 'https://www.embassyofindonesia.org',
      contact: '+1 (202) 775-5200',
      image: { src: 'https://www.indonesia.travel/content/dam/indtravelrevamp/en/destinations/revision-2019/4.jpg', alt: 'Embassy of Indonesia in the U.S.' },
    },
    {
      title: 'Embassy of the United States in Indonesia',
      address: 'Jl. Medan Merdeka Selatan No. 3–5, Jakarta 10110',
      website: 'https://id.usembassy.gov',
      contact: '+62-21-5083-1000',
      image: { src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/8/87/Mount_Rushmore_detail_view_%28100MP%29.jpg/1920px-Mount_Rushmore_detail_view_%28100MP%29.jpg', alt: 'U.S. Embassy in Indonesia' },
    },
    {
      title: 'KJRI San Francisco',
      address: '1111 Columbus Avenue, San Francisco, CA 94133',
      website: 'https://kemlu.go.id/sanfrancisco/id',
      contact: '+1 (415) 875 0793',
      image: { src: 'https://raw.githubusercontent.com/BawbleXD/Images-Pernas/refs/heads/main/Golden%20gate.jpg', alt: 'KJRI San Francisco' },
    },
    {
      title: 'KJRI New York',
      address: '5 E 68th St, New York, NY 10065',
      website: 'https://kjrinewyork.org/',
      contact: '+1 (212) 879-0600',
      image: { src: 'https://cdn-imgix.headout.com/tour/30357/TOUR-IMAGE/6cdcf542-452d-4897-beed-76cf68f154e4-1act-de005e04-05d9-4715-96b0-6a089d5c3460.jpg?auto=format&w=1222.3999999999999&h=687.6&q=90&fit=crop&ar=16%3A9&crop=faces', alt: 'KJRI New York' },
    },
    {
      title: 'KJRI Chicago',
      address: '211 N Carpenter St, Chicago, IL 60607',
      website: 'https://kemlu.go.id/chicago',
      contact: '+1 (312) 920 1880',
      image: { src: 'https://skylinespace.nyc3.cdn.digitaloceanspaces.com/media/images/chicago_000_4550_up.jpg', alt: 'KJRI Chicago' },
    },
    {
      title: 'KJRI Houston',
      address: '10900 Richmond Avenue, Houston, TX 77042',
      website: 'https://kemlu.go.id/houston/',
      contact: '+1 (713) 785 1691',
      image: { src: 'https://blog.cirquedusoleil.com/-/media/blog/fb_open_graph/brainlabs-articles/houston/bl-houston-architecture/houston_skyline_texas_tower_facebook_cover.jpg?db=web&vs=1&hash=10E2936B538E806AB522E662EE59BF00', alt: 'KJRI Houston' },
    },
    {
      title: 'KJRI Los Angeles',
      address: '3457 Wilshire Boulevard, Los Angeles, CA 90010',
      website: 'https://kemlu.go.id/losangeles/',
      contact: '+1 (213) 387 7041',
      image: { src: 'https://offloadmedia.feverup.com/secretlosangeles.com/wp-content/uploads/2024/02/26040501/los-angeles-attractions.jpg', alt: 'KJRI Los Angeles' },
    },
  ]}
/>

  <!-- VISA PROCESS -->
  <Hero3
  id="visa-process"
  tagline="VISA"
  title="VISA Process"
  subtitle="The best place to obtain information is your school's international student office, as each school may have its own process for issuing the necessary support documents."
  actions={[
    {
      variant: 'primary',
      text: 'Info for Student Visa',
      href: 'https://travel.state.gov/content/travel/en/us-visas/study/student-visa.html',
      icon: 'tabler:square-rounded-arrow-right',
    },
  ]}
  image={{
    src: 'https://media.istockphoto.com/id/480471413/photo/us-visa.jpg?s=612x612&w=0&k=20&c=4rhDBU45a2ODoN1Eil6543p6qbEPnpgtAhKlbfxRhVo=',
    alt: 'Visa Picture',
  }}
/>


<!-- Academics -->
<Acedemics
  id="Academics"
  tagline="Academics"
  title="How to Apply to US Universities?"
  subtitle="Unlock your future—take the first step toward studying in the US."
  actions={[
    {
      variant: 'primary',
      text: 'Homeland Security',
      href: 'https://studyinthestates.dhs.gov/',
      icon: 'tabler:square-rounded-arrow-right',
    },
    {
      variant: 'primary',
      text: 'US Grad School Admissions',
      href: 'https://www.topuniversities.com/student-info/admissions-advice/us-grad-school-admissions-7-steps%C2%A0', //FIX THIS LINK ITS BROKEN
      icon: 'tabler:square-rounded-arrow-right',
    },
  ]}
  image={{
    src: 'https://cache.careers360.mobi/media/article_images/2021/12/31/top-universities-2022.webp',
    alt: 'Applying to US Universities',
  }}
/>

  <!-- Job Hunting -->
  <Hero3
  id="Job_Hunting"
  tagline="Jobs & Internships"
  title="Job and Internship Opportunities"
  subtitle="Unlock new opportunities and take the next step in your career journey."
  actions={[
    {
      variant: 'primary',
      text: 'Aparatur Sipil Negara Recruitment',
      href: 'https://sscasn.bkn.go.id/',
      icon: 'tabler:square-rounded-arrow-right',
    },
  ]}
  image={{
    src: 'https://media.licdn.com/dms/image/v2/D4E12AQF7UYQqT8iB6Q/article-cover_image-shrink_720_1280/article-cover_image-shrink_720_1280/0/1690528822460?e=2147483647&v=beta&t=HZnHMoh7deg75xmKYezxZNvfiMkI6TdAEH2Xjp5przE',
    alt: 'FAANG Interns',
  }}
/>

  <!-- Research -->
  <ResearchSection
  id="Research"
  title="Research"
  subtitle="Explore major academic institutions, private research organizations, and collaboration opportunities for research in Indonesia."
  sections={[
    {
      title: "Major Academic Institutions (Outside of Universities)",
      content: [
        { text: "National Labs - Government Research Labs generally offer various postdoctoral positions.", link: "https://www.energy.gov/science/doe-national-laboratories" }
      ],
      image: "https://www.cannondesign.com/img/3b39b7e9-ff17-4ea8-9fa6-1152f3c3705e/005063_00_N82_cdwebsite.jpg?fm=jpg&q=80&fit=max&crop=3000%2C2000%2C0%2C0&w=1000"
    },
    {
      title: "Private Research Institutions",
      content: [
        { text: "The Brookings Institution", link: "https://www.brookings.edu/" },
        { text: "Harvard Kennedy School Belfer Center", link: "https://www.belfercenter.org/" },
        { text: "Broad Institute", link: "https://www.broadinstitute.org/" },
        { text: "Genentech", link: "https://www.gene.com/" },
        { text: "National Bureau of Economic Research", link: "https://www.nber.org/" },
        { text: "OpenAI", link: "https://openai.com/" }
      ],
      image: "https://images2.minutemediacdn.com/image/upload/c_fill,w_720,ar_16:9,f_auto,q_auto,g_auto/shape/cover/sport/mf-22120-wikimedia-randcorporationsantamonica-10ce8111d91e91af391ee3b20e5935b6.jpg"
    },
    {
      title: "Indonesian Research Communities & Think Tanks",
      content: [
        { text: "Indonesia Corruption Watch", link: "https://www.antikorupsi.org/" },
        { text: "CSIS", link: "https://www.csis.or.id/" },
        { text: "Economic Research Institute for ASEAN and East Asia", link: "https://www.eria.org/" },
        { text: "Center for Indonesian Policy Studies", link: "https://www.cips-indonesia.org/" },
        { text: "LIPI", link: "http://lipi.go.id/" },
        { text: "The Habibie Center", link: "https://habibiecenter.or.id/" },
        { text: "World Bank Indonesia", link: "https://www.worldbank.org/en/country/indonesia" },
        { text: "JPAL Indonesia", link: "https://www.povertyactionlab.org/southeast-asia" },
        { text: "Center for Sustainable Development Goals Studies - Universitas Padjadjaran", link: "https://csdgs.unpad.ac.id/" }
      ],
      image: "https://csis-website-prod.s3.amazonaws.com/s3fs-public/program/160209_CSIS_headquarters_main_image_0.jpg"
    },
    {
      title: "Formal Academic Communities & Societies",
      content: [
        { text: "IEEE Indonesia Section", link: "https://ieee.id/" },
        { text: "Indonesian Society of Human Genetics (InaSHG)", link: "https://www.inashg.org/" },
        { text: "The Indonesian Society for Biochemistry and Molecular Biology", link: "https://isbmmb.org/" }
      ],
      image: "https://biologi.ugm.ac.id/wp-content/uploads/sites/11/2024/11/Ardiza-2-700x500.jpg"
    },
    {
      title: "Research Collaboration",
      content: [
        { text: "To do research in Indonesia, foreign researchers are required to have collaborators in Indonesia who can sponsor their study.", link: "https://www.ristekbrin.go.id/" },
        { text: "Foreign Research Permit is required for international researchers.", link: "https://frp.ristekbrin.go.id/" }
      ],
      image: "https://unbound.upcea.edu/wp-content/uploads/2016/10/partnership-across-table-1024x931.jpg"
    }
  ]}
/>

<!-- Scholarships -->
<Scholarships
  id="Scholarships"
  title="Scholarship Opportunities"
  subtitle="Find scholarships that support your studies and research aspirations."
  columns={3}
  items={[
    {
      title: "Lembaga Pengelola Dana Pendidikan (LPDP)",
      description: "A prestigious Indonesian government-funded scholarship for postgraduate studies in top universities worldwide.",
      link: "https://www.lpdp.kemenkeu.go.id/",
      image: { src: "https://www.pajak.com/storage/2024/12/e493ee5950c0279e74f30f812d2a1c0b-1.jpg", alt: "LPDP Scholarship" }
    },
    {
      title: "United States-Indonesia Society (USINDO)",
      description: "Scholarships and educational programs fostering U.S.-Indonesia bilateral relations through academic exchanges.",
      link: "https://usindo.org/",
      image: { src: "https://media.licdn.com/dms/image/v2/C511BAQFKM-qxakMS9w/company-background_10000/company-background_10000/0/1584486188694/us_indonesia_society_cover?e=2147483647&v=beta&t=7crUlTX0j5EpNS9vfT2EtLmMwrPyLZdJwPcIWDLK1js", alt: "USINDO Scholarship" }
    },
    {
      title: "American Indonesian Exchange Foundation (AMINEF) Grants",
      description: "Funding opportunities for Indonesian students and scholars to pursue higher education in the United States.",
      link: "https://www.aminef.or.id/",
      image: { src: "https://cdn-web.ruangguru.com/landing-pages/assets/hs/Aminef.webp", alt: "AMINEF Grants" }
    },
    {
      title: "Fulbright Doctoral Degree Scholarship",
      description: "A prestigious scholarship program supporting Indonesian students to pursue doctoral studies in the U.S.",
      link: "https://www.aminef.or.id/grants-for-indonesians/fulbright-programs/fulbright-doctoral-degree-scholarship/",
      image: { src: "https://pl.usembassy.gov/wp-content/uploads/sites/23/fulbright_logo_small-1.jpg", alt: "Fulbright Scholarship" }
    },
    {
      title: "AIFIS Fellowship",
      description: "A fellowship program supporting research collaborations between Indonesian and American scholars.",
      link: "https://www.aifis.org/fellowship-programs",
      image: { src: "https://static1.squarespace.com/static/59762c21c534a5ea5de4e64b/t/644ff38ffce9230a1dd081f4/1738092190226/", alt: "AIFIS Fellowship" }
    }
  ]}
/>

