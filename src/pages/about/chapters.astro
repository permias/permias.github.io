---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';

import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Chapter',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="PERMIAS Chapters"
    tagline="Discover Your PERMIAS Chapters"
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Register your Chapters with us!',
        href: getPermalink('https://forms.gle/bx9bQx9eRBDgLTy57')
      },
    ]}
  >
    
  <Fragment slot="image">
      <iframe class="airtable-embed" src="https://www.google.com/maps/d/embed?mid=1hgQeyDLLXqzxY9F8CZZbdLaPzpMN3Ts&ehbc=2E312F" 
     width="100%" height="650" 
      style="background: transparent; border: 1px solid #ccc;"
      ></iframe>
    </Fragment>
  </Hero>

  <!-- Features2 Widget ************** -->

  <Features2
    title="EAST COAST ASSOCIATION"
  >
  </Features2>
  <iframe class="airtable-embed lg:mt-[-100px] mt-[-50px] xl:h-[1150px] lg:h-[750px] h-[500px]" src="https://airtable.com/embed/app5odBJE0V9SbkWE/shrvIsbTmGBQYDPmf?viewControls=on" 
      width="75%" style="background: transparent; margin-left: auto; margin-right: auto;"
  ></iframe>

  <Features
    title="MIDWEST REGION ASSOCIATION"
  >
  </Features>
  <iframe class="airtable-embed lg:mt-[-100px] mt-[-50px] xl:h-[1000px] lg:h-[750px] h-[500px] " src="https://airtable.com/embed/app5odBJE0V9SbkWE/shrCfTTBQbfcRSZCY?viewControls=on" 
     width="75%" style="background: transparent; margin-left: auto; margin-right: auto;"   
  ></iframe>

  <Features2
    title="WEST COAST ASSOCIATION"
  >
  </Features2>
  <iframe class="airtable-embed lg:mt-[-100px] mt-[-50px] lg:h-[600px] h-[500px]" src="https://airtable.com/embed/app5odBJE0V9SbkWE/shr1AmNC9gqOTPy72?viewControls=on"
    width="75%" style="background: transparent; margin-left: auto; margin-right: auto;"
  ></iframe>
  
  <Features
    title="SOUTHERN REGION ASSOCIATION"
  >
  </Features>
  <iframe class="airtable-embed lg:mt-[-100px] mt-[-50px] lg:h-[600px] h-[500px]" src="https://airtable.com/embed/app5odBJE0V9SbkWE/shrQhixey1ZkVWbaP?viewControls=on"
     width="75%" style="background: transparent; margin-left: auto; margin-right: auto; margin-bottom: 100px;"
  ></iframe>

</Layout>
