---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import ChapterPage from '~/components/app/ChapterPage';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Chapter',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget -->

  <Hero
    id="hero"
    title="PERMIAS Chapters"
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Daftarkan Cabangmu Sekarang!',
        href: getPermalink('https://forms.gle/bx9bQx9eRBDgLTy57'),
      },
    ]}
  />
  <div style="margin-top: -8rem;">
    <ChapterPage client:load />
  </div>
</Layout>
