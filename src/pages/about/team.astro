---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';

import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';

const metadata = {
  title: 'Our Team',
};
---
<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="Our Team"
  ></Hero>

  <!-- Features2 Widget ************** -->
  <div class="lg:mt-[-200px] md:mt-[-175px] mt-[-125px]">
    <Features2
      title="Executive Board"
    >
    </Features2>
    <iframe class="airtable-embed lg:mt-[-100px] mt-[-50px]" src="https://airtable.com/embed/appRyqXmkixlqmaIN/shrMkFqMSAFJyHPto?" 
        width="75%" height="500" style="background: transparent; margin-left: auto; margin-right: auto;"
    ></iframe>
  </div>

  <Features
    title="Academics"
  >
  </Features>
  <iframe class="airtable-embed  lg:mt-[-100px] mt-[-50px]" src="https://airtable.com/embed/appRyqXmkixlqmaIN/shrze3UQbcN1frDZR?"
    width="75%" height="950" style="background: transparent; margin-left: auto; margin-right: auto;"
  ></iframe>

  <Features2
    title="Organizational Development"
  >
  </Features2>
  <iframe class="airtable-embed lg:mt-[-100px] mt-[-50px]" src="https://airtable.com/embed/appRyqXmkixlqmaIN/shr6PUsHnIhAEGTmL?"
    width="75%" height="950" style="background: transparent; margin-left: auto; margin-right: auto;"
  ></iframe>

  <Features
    title="Professional Development"
  >
  </Features>
  <iframe class="airtable-embed lg:mt-[-100px] mt-[-50px]" src="https://airtable.com/embed/appRyqXmkixlqmaIN/shrzHWoFQ5A0DuVhl?"
    width="75%" height="950" style="background: transparent; margin-left: auto; margin-right: auto;"
  ></iframe>
  
  <Features2
    title="Publication and Promotions"
  >
  </Features2>
  <iframe class="airtable-embed lg:mt-[-100px] mt-[-50px]" src="https://airtable.com/embed/appRyqXmkixlqmaIN/shrpPFrPo3I9hKhmJ?" 
    width="75%" height="950" style="background: transparent; margin-left: auto; margin-right: auto; margin-bottom: 100px"
  ></iframe>

</Layout>
